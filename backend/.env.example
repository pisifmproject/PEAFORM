# Database Configuration
DATABASE_URL=postgres://user:password@localhost:5432/peaform

# JWT Secret Key (Change this in production!)
JWT_SECRET=your-secret-key-here-change-in-production

# Environment (development | production)
NODE_ENV=development

# Backend Port
PORT=3002

# Frontend URL (for CORS)
# Development: http://localhost:5173
# Production: http://10.125.48.102/peaf
FRONTEND_URL=http://localhost:5173

# Upload Directory (absolute path)
UPLOAD_DIR=C:/path/to/upload/directory

# Cookie Path
# Development: leave empty or set to /
# Production: /peaf (must match your base path)
COOKIE_PATH=

# SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PEAF System <noreply@example.com>"
